{
  "expo": {
    "name": "RapidFundi",
    "slug": "rapidfundi-app",
    "scheme": "rapidfundi",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.rapidfundi.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rapidfundi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow RapidFundi to use your camera to take photos of jobs",
        "NSPhotoLibraryUsageDescription": "Allow RapidFundi to access photos"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RapidFundi to use your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RapidFundi to access your photos.",
          "cameraPermission": "Allow RapidFundi to use your camera."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "338767c9-8e70-4613-9408-5159e3e658e3"
      }
    },
    "owner": "devwizzard"
  }
}