{
  "expo": {
    "name": "RapidFundi",
    "slug": "rapidfundi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rapidfundi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rapidfundi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RapidFundi uses your location to find nearby plumbers.",
        "NSCameraUsageDescription": "RapidFundi needs camera to upload job photos.",
        "NSPhotoLibraryUsageDescription": "RapidFundi needs photo library to upload job photos."
      }
    },
    "android": {
      "package": "com.rapidfundi.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}